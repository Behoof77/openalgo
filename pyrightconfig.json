{
  "include": [
    "app.py",
    "blueprints",
    "broker",
    "database",
    "restx_api",
    "services",
    "utils",
    "websocket_proxy"
  ],
  "exclude": [
    ".venv",
    "frontend",
    "node_modules",
    "db",
    "log",
    "strategies",
    ".git",
    "__pycache__",
    "**/__pycache__",
    "**/*.pyc"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "information",
  "reportMissingTypeStubs": "none",
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic"
}